# Configuración local de VHSA.
# Compose lee el archivo .env ubicado en la raíz.
FRONT_PORT=3000
API_PORT=3001
MONGO_HOST_PORT=27018
MONGO_DB_NAME=vhsa_dev
MONGO_TEST_DB_NAME=vhsa_test

# Administrador de infraestructura; no usar en la API.
MONGO_INITDB_ROOT_USERNAME=vhsa_root
MONGO_INITDB_ROOT_PASSWORD=

# Generadas por scripts/setup-mongo-users.mjs si no existen en .env.
# Usuario vhsa_app: readWrite únicamente en vhsa_dev.
MONGO_APP_PASSWORD=
# Usuario vhsa_test: readWrite únicamente en vhsa_test.
MONGO_TEST_PASSWORD=
