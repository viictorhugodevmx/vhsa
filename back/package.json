{
  "name": "@vhsa/back",
  "version": "0.1.0",
  "private": true,
  "description": "API de VHSA con Express y MongoDB.",
  "type": "module",
  "engines": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node --env-file=.env --import tsx src/check-database.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.19.21",
    "@types/supertest": "6.0.3",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
